.text {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 12px;
}

.app-card {
    flex-grow: 1;
    flex-basis: auto;
    max-width: none;
    margin: 8px;
    background-color: rgb(32, 32, 32);
    border-radius: 8px;
    padding: 8px;
    align-items: center;
}

.app-icon {
    width: 300px;
    height: 300px;
    border-radius: 16px;
    background-color: rgba(60, 60, 60, 0);
}

.app-name {
    font-size: 50px;
    color: white;
    -unity-font-style: bold;
    margin-top: 6px;
    white-space: normal;
    align-self: stretch;
    width: 100%;
}

.app-rating {
    font-size: 50px;
    color: rgb(255, 255, 255);
    margin-top: 4px;
    align-self: flex-start;
}

.round-button {
    margin-left: 40px;
    width: 100px;
    height: 100px;
    align-self: center;
    border-top-left-radius: 70px;
    border-top-right-radius: 70px;
    border-bottom-right-radius: 70px;
    border-bottom-left-radius: 70px;
    background-color: rgb(42, 51, 51);
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.screen-root {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(22, 28, 28);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: translate, opacity;
    transition-duration: 260ms, 180ms;
    transition-timing-function: ease-out, ease-out;
    background-color: rgb(22, 28, 28);
}

.main-screen {
    translate: 0 0;
    opacity: 1;
}

.main-screen--closed {
    translate: -100% 0;
    opacity: 0.35;
    picking-mode: ignore;
}

.details-screen {
    translate: 100% 0;
    opacity: 0;
    picking-mode: ignore;
}

.details-screen--open {
    translate: 0 0;
    opacity: 1;
    picking-mode: position;
}

.screenshot-item {
    height: 550px;
    width: auto;
    margin-left: 12px;
    margin-right: 12px;
    border-radius: 20px;
    overflow: hidden;
    flex-shrink: 0;
    aspect-ratio: auto;
    flex-grow: 0;
}

.screenshot-image {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 0;
}
