.text {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.apps-container {
    padding: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
}

.app-card {
    flex-grow: 0;
    flex-basis: 316px;
    margin: 8px;
    background-color: rgba(32, 32, 32, 0);
    border-radius: 8px;
    padding: 8px;
    align-items: center;
    flex-shrink: 0;
    width: 316px;
    flex-direction: column;
    justify-content: flex-start;
}

.app-icon {
    border-radius: 16px;
    flex-shrink: 0;
    overflow: hidden;
    width: 300px;
    height: 300px;
    flex-grow: 0;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
}

.app-name {
    font-size: 50px;
    color: white;
    -unity-font-style: bold;
    margin-top: 6px;
    white-space: normal;
    align-self: stretch;
    width: 100%;
}

.app-rating {
    font-size: 50px;
    color: rgb(255, 255, 255);
    margin-top: 4px;
    align-self: flex-start;
    flex-shrink: 0;
}

.screen-root {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    background-color: rgb(22, 28, 28);
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: translate, opacity;
    transition-duration: 260ms, 180ms;
    transition-timing-function: ease-out, ease-out;
    background-color: rgb(22, 28, 28);
}

.main-screen {
    translate: 0 0;
    opacity: 1;
}

.main-screen--closed {
    translate: -100% 0;
    opacity: 0.35;
}

.details-screen {
    translate: 100% 0;
    opacity: 0;
}

.details-screen--open {
    translate: 0 0;
    opacity: 1;
}

.screenshot-item {
    height: 550px;
    width: auto;
    margin-left: 12px;
    margin-right: 12px;
    border-radius: 20px;
    overflow: hidden;
    flex-shrink: 0;
    aspect-ratio: auto;
    flex-grow: 0;
}

.screenshot-image {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    -unity-background-scale-mode: scale-to-fit;
    flex-grow: 0;
}

.apps-view {
    height: 540px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 30px;
    margin-bottom: 30px;
}

.header-container {
    height: 200px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 30px;
    padding-right: 30px;
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
}

.header-spacer {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 16px;
}

.play-market-icon {
    width: 120px;
    height: 120px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 18px;
}

.play-market-label {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    font-size: 40px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.user-avatar {
    width: 120px;
    height: 120px;
    flex-grow: 0;
    flex-shrink: 0;
}

.details-header-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 200px;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 30px;
    padding-right: 30px;
}

.header-round-button {
    width: 100px;
    height: 100px;
    flex-grow: 0;
    flex-shrink: 0;
    border-top-left-radius: 70px;
    border-top-right-radius: 70px;
    border-bottom-right-radius: 70px;
    border-bottom-left-radius: 70px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(22, 28, 28);
    color: white;
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.back-button {
    padding-bottom: 8px;
}

.more-button {
    font-size: 72px;
    padding-bottom: 18px;
}

.header-round-button:hover {
    background-color: rgb(40, 53, 53);
}

.screenshot-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    overflow: hidden;
    background-color: rgb(22, 28, 28);
}

.screenshot-overlay--open {
    display: flex;
}

.screenshot-overlay-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(22, 28, 28);
}

.screenshot-overlay-header {
    height: 200px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 30px;
    padding-right: 30px;
}

.close-screenshot-button {
    font-size: 40px;
    padding-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.576);
}

.fullscreen-screenshot-area {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    padding-top: 0;
    background-color: rgba(22, 28, 28, 0);
}

.fullscreen-screenshot-image {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
}

.install-button {
    background-color: rgb(0, 123, 86);
    flex-shrink: 0;
    height: 100px;
    margin-top: 10px;
    margin-right: 30px;
    margin-bottom: 10px;
    margin-left: 30px;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.install-button:hover {
    background-color: rgb(6, 183, 130);
}
